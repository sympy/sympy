#!/usr/bin/env python
"""Test runner for SymPy with -k option fix."""
import sys
import subprocess

def run_tests(k_pattern=None):
    cmd = [sys.executable, '-c', 'import sympy; sympy.test()']
    if k_pattern:
        # Fix: properly pass -k pattern to pytest
        cmd.extend(['-k', k_pattern])
    result = subprocess.run(cmd)
    return result.returncode

if __name__ == '__main__':
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument('-k', '--k-pattern', help='Pattern to filter tests')
    args = parser.parse_args()
    sys.exit(run_tests(args.k_pattern))
